{{!
    @template local_curricmap/mappings

    Per-course curriculum mappings, grouped by location.

    Context variables required for this template:
    * hasanchors - whether any anchor nodes resolve for the course
    * anchors - array of {nodetitle, nodecode, programmelabel}
    * hasgroups - whether any binding groups exist
    * groups - array of {heading, inherited, rows}
    * hasorphaned - whether orphaned bindings exist
    * orphaned - array of binding rows

    Example context (json):
    {
        "hasanchors": true,
        "anchors": [{"nodetitle": "Year 1", "nodecode": "UG1", "programmelabel": "vet-med 2026/27"}],
        "hasgroups": true,
        "groups": [{
            "heading": "Whole course",
            "inherited": false,
            "rows": [{
                "id": 1, "nodetitle": "Locomotor", "nodecode": "", "noderole": "strand",
                "programmelabel": "vet-med 2026/27", "relation": "anchor", "isanchor": true,
                "iscentral": false, "candelete": true, "deleteurl": "#"
            }]
        }],
        "hasorphaned": false,
        "orphaned": []
    }
}}
{{#hasanchors}}
<div class="alert alert-info">
    <strong>{{#str}} mappings_anchors, local_curricmap {{/str}}</strong>
    <ul class="mb-0">
        {{#anchors}}
        <li>{{nodetitle}}{{#nodecode}} ({{nodecode}}){{/nodecode}}
            <span class="text-muted">— {{programmelabel}}</span></li>
        {{/anchors}}
    </ul>
</div>
{{/hasanchors}}
{{^hasgroups}}
<p>{{#str}} mappings_none, local_curricmap {{/str}}</p>
{{/hasgroups}}
{{#groups}}
<h4 class="mt-4">{{heading}}
    {{#inherited}}<span class="badge badge-secondary bg-secondary">{{#str}} mappings_inherited, local_curricmap {{/str}}</span>{{/inherited}}
</h4>
<table class="table table-sm generaltable">
    <thead>
        <tr>
            <th>{{#str}} mappings_node, local_curricmap {{/str}}</th>
            <th>{{#str}} mappings_programme, local_curricmap {{/str}}</th>
            <th>{{#str}} mappings_relation, local_curricmap {{/str}}</th>
            <th>{{#str}} mappings_scope, local_curricmap {{/str}}</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        {{#rows}}
        <tr>
            <td>{{nodetitle}}{{#nodecode}} ({{nodecode}}){{/nodecode}}
                <span class="text-muted small">{{noderole}}</span></td>
            <td>{{programmelabel}}</td>
            <td>{{#isanchor}}<span class="badge badge-primary bg-primary">{{relation}}</span>{{/isanchor}}{{^isanchor}}{{relation}}{{/isanchor}}</td>
            <td>{{#iscentral}}<span class="badge badge-warning bg-warning" title="{{#str}} mappings_centrallocked, local_curricmap {{/str}}">{{#str}} scope_central, local_curricmap {{/str}}</span>{{/iscentral}}{{^iscentral}}<span class="badge badge-info bg-info">{{#str}} scope_course, local_curricmap {{/str}}</span>{{/iscentral}}</td>
            <td>{{#candelete}}<a href="{{deleteurl}}" class="text-danger">{{#str}} delete {{/str}}</a>{{/candelete}}</td>
        </tr>
        {{/rows}}
    </tbody>
</table>
{{/groups}}
{{#hasorphaned}}
<h4 class="mt-4">{{#str}} mappings_orphaned, local_curricmap {{/str}}</h4>
<p class="text-muted">{{#str}} mappings_orphaned_desc, local_curricmap {{/str}}</p>
<table class="table table-sm generaltable">
    <tbody>
        {{#orphaned}}
        <tr>
            <td>{{nodetitle}}{{#nodecode}} ({{nodecode}}){{/nodecode}}</td>
            <td>{{programmelabel}}</td>
            <td>{{relation}}</td>
            <td>{{#candelete}}<a href="{{deleteurl}}" class="text-danger">{{#str}} delete {{/str}}</a>{{/candelete}}</td>
        </tr>
        {{/orphaned}}
    </tbody>
</table>
{{/hasorphaned}}
